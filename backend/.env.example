# LLM Provider Selection: "google" or "ollama"
LLM_PROVIDER=google

# Google GenAI Settings
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-2.5-flash

# Ollama Settings
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
# Set OLLAMA_NUM_GPU=0 to run Ollama strictly on CPU mode (bypasses CUDA driver issues)
OLLAMA_NUM_GPU=0
